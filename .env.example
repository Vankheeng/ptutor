# PostgreSQL / Docker Compose
POSTGRES_IMAGE=<pgvector-postgres-image>
POSTGRES_CONTAINER_NAME=<postgres-container-name>
POSTGRES_RESTART=<container-restart-policy>
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-username>
POSTGRES_PASSWORD=<database-password>
POSTGRES_PORT=<host-database-port>
POSTGRES_VOLUME_NAME=<docker-volume-name>

# Spring Boot datasource
DB_URL=<jdbc-postgresql-url>
DB_USERNAME=<database-username>
DB_PASSWORD=<database-password>

# Authentication and security
JWT_SECRET=<minimum-32-byte-jwt-secret>
JWT_ISSUER=<jwt-issuer>
JWT_ACCESS_TOKEN_TTL=<access-token-ttl-seconds>
JWT_REFRESH_TOKEN_TTL=<refresh-token-ttl-seconds>
CITIZEN_ID_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
BANK_ACCOUNT_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
CORS_ALLOWED_ORIGINS=<comma-separated-allowed-origins>
ACCOUNT_SUSPENSION_EXPIRATION_INTERVAL_MS=<temporary-suspension-scan-interval-ms>

# Certificate files: Supabase Storage (S3 protocol) or another S3-compatible provider.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# Usually the same endpoint; use a browser-reachable URL when it differs from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<region-from-supabase-s3-settings>
S3_BUCKET=<private-supabase-storage-bucket>
S3_ACCESS_KEY=<generated-supabase-s3-access-key>
S3_SECRET_KEY=<generated-supabase-s3-secret-key>
S3_PRESIGN_DURATION=<signed-download-link-lifetime-e.g.-PT15M>

# SMTP email delivery
MAIL_HOST=<production-smtp-host>
MAIL_PORT=<production-smtp-port>
MAIL_USERNAME=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>
MAIL_FROM=<verified-sender-address>

# VNPay payment gateway
PAYMENT_STUDYING_REQUEST_FEE=<whole-vnd-fee>
PAYMENT_TEACHING_REQUEST_FEE=<whole-vnd-fee>
VNPAY_TMN_CODE=<vnpay-terminal-code>
VNPAY_HASH_SECRET=<vnpay-hmac-sha512-secret>
VNPAY_PAYMENT_URL=<vnpay-sandbox-or-production-payment-url>
VNPAY_RETURN_URL=<public-backend-vnpay-return-url>
VNPAY_FRONTEND_RETURN_URL=<frontend-payment-result-url>
VNPAY_IPN_URL=<public-https-backend-vnpay-ipn-url>
VNPAY_EXPIRY_MINUTES=<payment-url-expiry-minutes>
VNPAY_TIME_ZONE=<vnpay-time-zone>

# In-app notification scheduler
NOTIFICATION_PAYMENT_REMINDER_CRON=<six-field-cron-expression>
NOTIFICATION_TIME_ZONE=<notification-time-zone>

# Trợ lý hỗ trợ (docker compose --profile assistant) — xem docs/support-chatbot/trien-khai/HUONG-DAN-DEMO.md
# Chuỗi bí mật dùng chung backend ↔ assistant-service (ví dụ: python -c "import secrets;print(secrets.token_urlsafe(32))")
ASSISTANT_INTERNAL_TOKEN=<random-shared-secret>
# openai (mặc định) | scripted (CHỈ demo khi chưa có model: câu trả lời chép từ tài liệu, không phải model ngôn ngữ)
ASSISTANT_LLM_PROVIDER=openai
# Model ngôn ngữ tương thích OpenAI; thiếu model hoặc khoá thì trợ lý báo tạm thời không dùng được (503)
ASSISTANT_LLM_MODEL=<model-name>
OPENAI_API_KEY=<llm-api-key>
OPENAI_BASE_URL=<optional-openai-compatible-base-url>
# Trần token cho một lượt hỏi (mọi lời gọi model trong lượt)
ASSISTANT_TURN_TOKEN_BUDGET=40000
# fake | ai-service (ai-service cần AI_SERVICE_URL, AI_INTERNAL_TOKEN)
ASSISTANT_EMBEDDING_PROVIDER=fake
AI_SERVICE_URL=<ai-service-url>
AI_INTERNAL_TOKEN=<ai-service-internal-token>
# Ngưỡng chặn ngoài phạm vi phụ thuộc embedding. Với ai-service (bge-m3) dùng 0.65 / 0.02 (chọn trên dev, eval T3.7);
# không đặt = 0.55 / 0.05 (hiệu chỉnh cho embedding fake). Rerank: để false cho tới khi hiệu chỉnh lại min_rerank_score.
# ASSISTANT_SCOPE_TAU_IN=0.65
# ASSISTANT_SCOPE_DELTA=0.02
ASSISTANT_RERANK_ENABLED=false
# Seeder dữ liệu demo (Spring profile "demo"): mật khẩu chung của các tài khoản demo
DEMO_USER_PASSWORD=<demo-account-password>
FRONTEND_PORT=8088
BACKEND_PORT=8080
