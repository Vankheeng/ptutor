# PostgreSQL / Docker Compose
POSTGRES_IMAGE=<pgvector-postgres-image>
POSTGRES_CONTAINER_NAME=<postgres-container-name>
POSTGRES_RESTART=<container-restart-policy>
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-username>
POSTGRES_PASSWORD=<database-password>
POSTGRES_PORT=<host-database-port>
POSTGRES_VOLUME_NAME=<docker-volume-name>

# Spring Boot datasource
DB_URL=<jdbc-postgresql-url>
DB_USERNAME=<database-username>
DB_PASSWORD=<database-password>

# Authentication and security
# JWT_SECRET must contain at least 32 bytes.
JWT_SECRET=<minimum-32-byte-jwt-secret>
JWT_ISSUER=<jwt-issuer>
# Token TTL values are measured in seconds.
JWT_ACCESS_TOKEN_TTL=<access-token-ttl-seconds>
JWT_REFRESH_TOKEN_TTL=<refresh-token-ttl-seconds>
# Must be valid Base64 that decodes to exactly 32 bytes.
CITIZEN_ID_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# Use a comma-separated list when multiple frontend origins are allowed.
CORS_ALLOWED_ORIGINS=<comma-separated-allowed-origins>
