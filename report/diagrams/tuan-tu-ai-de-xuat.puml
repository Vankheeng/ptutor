@startuml
hide footbox
autonumber
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam sequence {
  ArrowColor #26323F
  LifeLineBorderColor #7B8794
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #4B83A4
  ParticipantBackgroundColor #BCE9FA
  ActorBorderColor #26323F
  GroupBorderColor #8DA7B8
  GroupBackgroundColor #F7FBFD
  ActivationBorderColor #4B83A4
  ActivationBackgroundColor #BCE9FA
}

actor "Học viên" as StudentActor
boundary "Giao diện\nđề xuất" as View
control "StudentRecommendation\nController" as Controller
control "Recommendation\nService" as Service
control "SavedSearch\nService" as SavedSearch
control "Student\nRepository" as StudentRepo
entity "Student" as StudentEntity
control "QueryContext\nBuilder" as Builder
control "StudyingRequest\nRepository" as StudyingRepo
entity "StudyingRequest" as StudyingEntity
control "Subject\nRepository" as SubjectRepo
entity "Subject" as SubjectEntity
control "Grade\nRepository" as GradeRepo
entity "Grade" as GradeEntity
control "RecommendationEntityTag\nRepository" as EntityTagRepo
entity "RecommendationEntityTag" as EntityTagEntity
participant "QueryContext\n(record DTO)" as Context
control "RecommendationTag\nRepository" as TagRepo
entity "RecommendationTag" as TagEntity
control "QueryEmbedding\nService" as Embedding
control "AiService\nClient" as AiClient
control "PTutor AI\nservice" as AI
control "Candidate\nRepository" as CandidateRepo
participant "TeachingCandidate\n(record DTO)" as Candidate
control "PreferenceProfile\nService" as Preference
control "RecommendationUserProfile\nRepository" as ProfileRepo
entity "RecommendationUserProfile" as ProfileEntity
control "Ranker" as Ranker
control "Feature\nCalculator" as FeatureCalc
control "Willingness\nCalculator" as WillingnessCalc
control "Weight\nProvider" as WeightProvider
control "Rerank\nService" as Rerank
control "Exploration\nService" as Explore
control "MatchReason\nBuilder" as Reason
control "Relaxation\nService" as Relax
control "Recommendation\nLogger" as Logger
control "QueryParse\nService" as QueryParse
control "CertificateFileStorage\nService" as FileStorage
entity "RecommendationLog" as Log
control "RecommendationLog\nRepository" as LogRepo

note over View,Controller
Nếu nhập câu tự nhiên, giao diện phân tích thành bộ lọc trước khi tìm kiếm.
Luồng tùy chọn này có sơ đồ tuần tự riêng.
Nếu dùng bộ tìm kiếm đã lưu, tiêu chí được nạp trước khi tạo ngữ cảnh.
end note

StudentActor -> View: Chọn yêu cầu học hoặc điều chỉnh tiêu chí
StudentActor -> View: Bắt đầu tìm gia sư
activate View
View -> Controller: Gửi tiêu chí đã xác nhận
activate Controller
Controller -> Service: Yêu cầu đề xuất gia sư
activate Service

Service -> StudentRepo: Tìm hồ sơ học viên hiện tại
StudentRepo -> StudentEntity: Nạp thông tin hồ sơ
StudentEntity --> StudentRepo: Thông tin học viên
StudentRepo --> Service: Hồ sơ học viên
opt Chọn bộ tìm kiếm đã lưu
  Service -> SavedSearch: Lấy tiêu chí đã lưu của học viên
  SavedSearch --> Service: Tiêu chí tìm kiếm
end
Service -> Builder: Kết hợp bộ lọc, hồ sơ và yêu cầu học
opt Học viên chọn một yêu cầu học đã đăng
  Builder -> StudyingRepo: Tìm yêu cầu học thuộc học viên
  StudyingRepo -> StudyingEntity: Nạp môn, lớp, khu vực và lịch học
  StudyingEntity --> StudyingRepo: Thông tin yêu cầu học
  StudyingRepo --> Builder: Yêu cầu học
end
opt Người dùng chọn môn học trong bộ lọc
  Builder -> SubjectRepo: Kiểm tra môn học còn hiệu lực
  SubjectRepo -> SubjectEntity: Nạp môn học
  SubjectEntity --> SubjectRepo: Thông tin môn học
  SubjectRepo --> Builder: Môn học hợp lệ
end
opt Người dùng chọn khối lớp trong bộ lọc
  Builder -> GradeRepo: Kiểm tra khối lớp còn hiệu lực
  GradeRepo -> GradeEntity: Nạp khối lớp
  GradeEntity --> GradeRepo: Thông tin khối lớp
  GradeRepo --> Builder: Khối lớp hợp lệ
end
Builder -> EntityTagRepo: Lấy nhãn hồ sơ và yêu cầu học
EntityTagRepo -> EntityTagEntity: Nạp các nhãn đã gán
EntityTagEntity --> EntityTagRepo: Nhãn và độ tin cậy
EntityTagRepo --> Builder: Nhãn phù hợp
opt Người dùng chọn nhãn nhu cầu hoặc phong cách
  Builder -> TagRepo: Tra cứu nhãn đang hoạt động
  TagRepo -> TagEntity: Nạp nhãn đề xuất
  TagEntity --> TagRepo: Tên và mã nhãn
  TagRepo --> Builder: Nhãn hợp lệ
end
Builder -> Context: Tạo ngữ cảnh tìm kiếm
Context --> Builder: Tiêu chí hợp nhất và trường còn thiếu
Builder --> Service: Ngữ cảnh đã tổng hợp

note over Service,Context
Nếu thiếu môn học hoặc khối lớp, hệ thống trả các trường cần bổ sung
và dừng tìm kiếm. Kịch bản ngoại lệ được mô tả trong bảng use case.
end note
  Service -> TagRepo: Lấy các nhãn đề xuất đang hoạt động
  TagRepo -> TagEntity: Nạp danh mục nhãn
  TagEntity --> TagRepo: Danh mục nhãn
  TagRepo --> Service: Tên và mã nhãn dùng để giải thích kết quả
  Service -> Embedding: Biểu diễn nhu cầu học thành vector
  Embedding -> AiClient: Gửi mô tả nhu cầu
  AiClient -> AI: Mã hóa bằng BGE-M3
  AI --> AiClient: Vector ngữ nghĩa
  AiClient --> Embedding: Vector nhu cầu
  Embedding --> Service: Vector tìm kiếm
  note right of Embedding
  Nếu đã có vector trong bộ nhớ đệm, bỏ qua lời gọi AI.
  Nếu AI không khả dụng, dùng vector hồ sơ đã có.
  end note

  Service -> CandidateRepo: Lọc các yêu cầu dạy còn hiệu lực
  CandidateRepo --> Service: Các yêu cầu qua điều kiện bắt buộc
  Service -> CandidateRepo: Lấy dữ liệu ứng viên và độ tương đồng
  CandidateRepo -> Candidate: Tập hợp dữ liệu gia sư và yêu cầu dạy
  Candidate --> CandidateRepo: Ứng viên đủ thông tin chấm điểm
  CandidateRepo --> Service: Danh sách ứng viên
  Service -> Preference: Lấy lịch sử tương tác của học viên
  Preference -> ProfileRepo: Tìm hồ sơ sở thích
  ProfileRepo -> ProfileEntity: Nạp tín hiệu và mức quan tâm
  ProfileEntity --> ProfileRepo: Hồ sơ sở thích
  ProfileRepo --> Preference: Dữ liệu sở thích
  Preference --> Service: Mức quan tâm và trọng số lịch sử
  Service -> Ranker: Chấm điểm và xếp hạng ứng viên
  loop Mỗi ứng viên qua bộ lọc
    Ranker -> FeatureCalc: Tính mức phù hợp với nhu cầu học
    FeatureCalc -> WeightProvider: Lấy trọng số mức phù hợp
    WeightProvider --> FeatureCalc: Trọng số hiện hành hoặc mặc định
    note right of WeightProvider
      Tác vụ nền cập nhật trọng số tự học ở luồng riêng.
      Chỉ chế độ ACTIVE dùng phiên bản đã kích hoạt;
      SHADOW hoặc OFF dùng trọng số mặc định.
    end note
    FeatureCalc --> Ranker: Đặc trưng và điểm phù hợp
    opt Bật đánh giá khả năng gia sư tiếp nhận
      Ranker -> WillingnessCalc: Tính khả năng gia sư nhận học viên
      WillingnessCalc -> WeightProvider: Lấy trọng số phía gia sư
      WeightProvider --> WillingnessCalc: Trọng số hiện hành hoặc mặc định
      WillingnessCalc --> Ranker: Khả năng tiếp nhận
    end
  end
  Ranker --> Service: Thứ hạng ban đầu
  Service -> Service: Giữ yêu cầu phù hợp nhất của mỗi gia sư
  Service -> Rerank: Kiểm tra điểm rerank đã có theo cấu hình
  Rerank --> Service: Trạng thái tắt và điểm rỗng khi cấu hình OFF
  Service -> Ranker: Giữ nguyên thứ hạng khi không có điểm rerank
  Ranker --> Service: Danh sách xếp hạng
  Service -> Explore: Chọn ứng viên khám phá theo cấu hình
  Explore --> Service: Danh sách được giữ lại
  Service -> Preference: Lấy các nhóm nhu cầu được quan tâm
  Preference -> ProfileRepo: Đọc mức quan tâm theo nhãn
  ProfileRepo --> Preference: Mức quan tâm đã lưu
  Preference --> Service: Mức độ quan tâm theo nhóm
  loop Mỗi ứng viên được đề xuất
    Service -> Reason: Tạo lý do phù hợp từ đặc trưng và sở thích
    Reason --> Service: Lý do hiển thị
  end
  Service -> Relax: Đánh giá khả năng nới điều kiện tìm kiếm
  Relax --> Service: Gợi ý điều chỉnh tiêu chí

  opt Người dùng đã nhập câu tự nhiên
    Service -> QueryParse: Lấy lại tiêu chí đã phân tích
    QueryParse --> Service: Nội dung phân tích để ghi nhật ký
  end
  Service -> Logger: Ghi tiêu chí, thứ hạng, lý do và thời gian xử lý
  Logger -> Log: Tạo bản ghi lần tìm kiếm
  Log --> Logger: Nhật ký đề xuất
  Logger -> LogRepo: Lưu thứ tự kết quả
  LogRepo --> Logger: Mã lần tìm kiếm
  Logger --> Service: Nhật ký đã lưu
  opt Ảnh đại diện của gia sư lưu trên S3
    Service -> FileStorage: Tạo URL truy cập ảnh đại diện
    FileStorage --> Service: URL hiển thị
  end
  Service --> Controller: Danh sách gia sư, lý do và gợi ý
  Controller --> View: Trả kết quả đề xuất
  View --> StudentActor: Hiển thị gia sư phù hợp

deactivate Service
deactivate Controller
deactivate View
@enduml
