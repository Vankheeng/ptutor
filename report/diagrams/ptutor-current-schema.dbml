  idempotency_key varchar(100) [not null]

  indexes {
    (wallet_id, idempotency_key) [unique]
  }
}

Table public.wallets {
  id uuid [pk]
  user_id uuid [unique, not null]
  balance numeric(15,2) [not null, default: 0]
  pending_balance numeric(15,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table public.withdrawal_requests {
  id uuid [pk]
  wallet_id uuid [not null]
  amount numeric(15,2) [not null]
  bank_code varchar(20) [not null]
  bank_name varchar(100) [not null]
  encrypted_account_number varchar(512) [not null]
  account_number_last_four varchar(4) [not null]
  account_holder_name varchar(150) [not null]
  note varchar(500)
  idempotency_key varchar(100) [not null]
  status varchar(30) [not null]
  reviewed_by_user_id uuid
  reviewed_at timestamp
  rejection_reason varchar(500)
  completed_at timestamp
  transfer_reference varchar(100)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  wallet_transaction_id uuid [unique]

  indexes {
    (wallet_id, idempotency_key) [unique]
  }
}

Table assistant.conversation {
  id uuid [pk]
  user_id uuid [not null]
  user_role varchar(20) [not null]
  title varchar(200) [not null]
  created_at timestamptz [not null, default: `now()`]
  last_message_at timestamptz [not null, default: `now()`]
  session_state jsonb
  ended_at timestamptz
  deleted_at timestamptz
}

Table assistant.deletion_log {
  id uuid [pk]
  conversation_id uuid [not null]
  requested_at timestamptz
  purged_at timestamptz [not null, default: `now()`]
  rows_deleted jsonb [not null]
  verified bool [not null]
}

Table assistant.kb_chunk {
  id uuid [pk]
  version_id uuid [not null]
  ordinal int [not null]
  heading_path varchar(500) [not null]
  anchor varchar(200) [not null]
  content text [not null]
  search_text text [not null]
  tsv tsvector
  embedding vector(1024)
  embedding_model varchar(80)
  token_count int [not null]
  audience "varchar(20)[]" [not null]
  features "varchar(40)[]" [not null]
  routes "varchar(200)[]" [not null]
  type varchar(20) [not null]
  is_active bool [not null, default: false]
}

Table assistant.kb_document {
  id uuid [pk]
  doc_key varchar(120) [unique, not null]
  active_version_id uuid
  status varchar(20) [not null]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table assistant.kb_document_version {
  id uuid [pk]
  document_id uuid [not null]
  version int [not null]
  state varchar(20) [not null]
  title varchar(255) [not null]
  type varchar(20) [not null]
  audience "varchar(20)[]" [not null]
  features "varchar(40)[]" [not null]
  routes "varchar(200)[]" [not null]
  keywords "varchar(80)[]" [not null]
  error_codes "varchar(80)[]" [not null]
  source_refs jsonb [not null]
  todo jsonb [not null]
  content_md text [not null]
  content_hash character(64) [not null]
  origin varchar(20) [not null]
  published_with_open_todo bool [not null, default: false]
  edited_by uuid
  edited_at timestamptz [not null, default: `now()`]
  published_by uuid
  published_at timestamptz
  restored_from_version int

  indexes {
    (document_id, version) [unique]
  }
}

Table assistant.kb_setting {
  key varchar(60) [pk]
  value jsonb [not null]
  updated_by uuid
  updated_at timestamptz [not null, default: `now()`]
}

Table assistant.message {
  id uuid [pk]
  conversation_id uuid [not null]
  sender varchar(10) [not null]
  reply_to_message_id uuid
  content text
  rewritten_query text
  intent varchar(20)
  grounded varchar(10)
  fallback_reason varchar(40)
  verification jsonb
  actions jsonb
  citations jsonb
  page_path varchar(200)
  llm_model varchar(80)
  prompt_version varchar(40)
  created_at timestamptz [not null, default: `now()`]
}

Table assistant.message_citation {
  message_id uuid [not null]
  chunk_id uuid [not null]
  rank int [not null]
  vector_score real
  text_score real
  rrf_score real
  rerank_score real
  in_context bool [not null, default: false]
  cited bool [not null, default: false]

  indexes {
    (message_id, chunk_id) [pk]
  }
}

Table assistant.message_feedback {
  message_id uuid [pk]
  user_id uuid [not null]
  rating smallint [not null]
  reason varchar(30)
  comment varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

Table assistant.scope_exemplar {
  id uuid [pk]
  text varchar(500) [not null]
  label varchar(10) [not null]
  source varchar(20) [not null]
  embedding vector(1024) [not null]
  embedding_model varchar(80) [not null]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table assistant.tool_call_log {
  id uuid [pk]
  message_id uuid [not null]
  tool_name varchar(80) [not null]
  args jsonb
  blocked_reason varchar(40)
  http_status int
  latency_ms int
  result_items int
  created_at timestamptz [not null, default: `now()`]
}

Table assistant.turn_trace {
  message_id uuid [pk]
  request_id varchar(64)
  config_hash character(12) [not null]
  status varchar(20) [not null]
  spans jsonb [not null]
  total_ms int [not null]
  tokens_in int [not null, default: 0]
  tokens_out int [not null, default: 0]
  model_calls smallint [not null, default: '0']
  tool_calls smallint [not null, default: '0']
  verify_retries smallint [not null, default: '0']
  created_at timestamptz [not null, default: `now()`]
}

