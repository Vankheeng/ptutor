# Postgres
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_CONTAINER_NAME=ptutor-postgres-prod
POSTGRES_RESTART=unless-stopped
POSTGRES_DB=ptutor
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=ptutor_postgres_data

# Spring Boot production datasource values
DB_URL=jdbc:postgresql://localhost:5432/ptutor
DB_USERNAME=
DB_PASSWORD=

# Authentication
JWT_SECRET=ptutor-local-jwt-secret-change-me-32-bytes
JWT_ISSUER=ptutor-api
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=2592000
ADMIN_EMAIL=admin@ptutor.local
ADMIN_PASSWORD=admin
CORS_ALLOWED_ORIGINS=http://localhost:5173
