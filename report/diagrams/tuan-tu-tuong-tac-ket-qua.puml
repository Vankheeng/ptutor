@startuml
hide footbox
autonumber
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam sequence {
  ArrowColor #26323F
  LifeLineBorderColor #7B8794
  ParticipantBorderColor #4B83A4
  ParticipantBackgroundColor #BCE9FA
  GroupBorderColor #8DA7B8
  GroupBackgroundColor #F7FBFD
  ActivationBorderColor #4B83A4
  ActivationBackgroundColor #BCE9FA
}

actor "Học viên" as Student
boundary "Giao diện\nđề xuất" as View
control "RecommendationInteraction\nController" as Interaction
control "RecommendationEvent\nService" as Event
control "Refine\nService" as Refine
control "StudentRecommendation\nController" as Controller
control "Recommendation\nService" as Recommend
control "RecommendationLog\nRepository" as LogRepo
entity "RecommendationLog" as Log
control "RecommendationClickLog\nRepository" as ClickRepo
entity "RecommendationClickLog" as Click
control "QueryEmbedding\nService" as Embedding
control "PreferenceSignal\nRepository" as SignalRepo
control "Candidate\nRepository" as CandidateRepo

opt Mở, yêu thích, liên hệ hoặc bỏ qua một kết quả
  Student -> View: Chọn thao tác với gia sư
  View -> Interaction: Gửi mã kết quả và loại tương tác
  Interaction -> Event: Ghi nhận tương tác của học viên
  Event -> LogRepo: Lấy lần tìm kiếm thuộc học viên
  LogRepo -> Log: Đọc danh sách đã đề xuất
  Log --> Event: Thứ hạng gốc của kết quả
  Event -> Click: Tạo bản ghi hành động
  Click --> Event: Tương tác với kết quả
  Event -> ClickRepo: Lưu tương tác
  ClickRepo --> Event: Đã ghi nhận
  Event --> Interaction: Hoàn tất
  Interaction --> View: Xác nhận thao tác
end

opt Tinh chỉnh danh sách chưa xem
  Student -> View: Yêu cầu tinh chỉnh
  View -> Interaction: Gửi mã lần tìm kiếm và vị trí đã xem
  Interaction -> Refine: Cập nhật thứ hạng còn lại
  Refine -> LogRepo: Đọc lần tìm kiếm đã lưu
  LogRepo --> Refine: Tiêu chí và thứ tự kết quả
  Refine -> ClickRepo: Đọc các tương tác đã ghi nhận
  ClickRepo --> Refine: Kết quả được thích hoặc bỏ qua
  Refine -> Embedding: Lấy vector nhu cầu của lần tìm kiếm
  Embedding --> Refine: Vector nhu cầu
  Refine -> SignalRepo: Lấy vector của các ứng viên đã thấy
  SignalRepo --> Refine: Vector ứng viên
  Refine -> Refine: Điều chỉnh vector và chấm lại mục chưa xem
  opt Có tín hiệu phù hợp và tính năng được bật
    Refine -> LogRepo: Lưu thứ hạng mới
    LogRepo --> Refine: Nhật ký đã cập nhật
  end
  Refine -> Recommend: Lấy các kết quả sau vị trí đã xem
  Recommend -> CandidateRepo: Nạp lại dữ liệu ứng viên còn hiệu lực
  CandidateRepo --> Recommend: Danh sách ứng viên
  Recommend --> Refine: Kết quả sau tinh chỉnh
  Refine --> Interaction: Danh sách chưa xem
  Interaction --> View: Trả kết quả mới
  View --> Student: Hiển thị thứ hạng đã cập nhật
end

opt Xem trang tiếp theo của lần tìm kiếm
  Student -> View: Chọn xem thêm
  View -> Controller: Gửi mã lần tìm kiếm và số trang
  Controller -> Recommend: Đọc trang kế tiếp
  Recommend -> LogRepo: Lấy thứ tự đã lưu
  LogRepo --> Recommend: Mã các ứng viên theo thứ hạng
  Recommend -> CandidateRepo: Nạp ứng viên còn hiệu lực
  CandidateRepo --> Recommend: Dữ liệu trang tiếp theo
  Recommend --> Controller: Trang kết quả
  Controller --> View: Trả kết quả
  View --> Student: Hiển thị thêm gia sư
end
@enduml
